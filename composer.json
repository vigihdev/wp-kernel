{
    "name": "vigihdev/wp-kernel",
    "description": "WordPress kernel framework that provides solid foundation for enterprise-level WordPress development with dependency injection, service containers, and modular architecture.",
    "keywords": [
        "wordpress",
        "kernel",
        "framework",
        "mvc",
        "wordpress-framework",
        "wordpress-kernel",
        "wordpress-mvc",
        "wordpress-development",
        "wp-kernel",
        "wp-framework",
        "wordpress-starter",
        "wordpress-boilerplate",
        "wordpress-architecture",
        "php",
        "composer-package",
        "wordpress-package",
        "wordpress-library",
        "wordpress-toolkit",
        "wordpress-application",
        "wordpress-structure"
    ],
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Vigih Dev",
            "email": "vigihdev@gmail.com",
            "role": "developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Vigihdev\\WpKernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vigihdev\\WpKernel\\Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "dev": "php -S localhost:2092 dev.php"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "vigihdev/serializer": "dev-main",
        "vigihdev/symfony-bridge-config": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.x-dev"
    }
}